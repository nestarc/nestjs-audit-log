generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id")
  actorId    String?  @map("actor_id")
  actorType  String   @default("user") @map("actor_type")
  actorIp    String?  @map("actor_ip")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  source     String   @default("auto")
  changes    Json?
  metadata   Json?
  result     String   @default("success")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model AuditGuardRoot {
  id       String             @id @default(uuid())
  branches AuditGuardBranch[]
}

model AuditGuardBranch {
  id     String           @id @default(uuid())
  rootId String
  root   AuditGuardRoot   @relation(fields: [rootId], references: [id])
  leaves AuditGuardLeaf[]
}

model AuditGuardLeaf {
  id       String           @id @default(uuid())
  branchId String
  branch   AuditGuardBranch @relation(fields: [branchId], references: [id])
}
