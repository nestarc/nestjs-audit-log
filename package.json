{
  "name": "@nestarc/audit-log",
  "version": "0.4.0",
  "description": "Audit logging module for NestJS with automatic Prisma change tracking and append-only PostgreSQL storage",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestarc/nestjs-audit-log.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nestjs",
    "audit-log",
    "audit-trail",
    "change-tracking",
    "prisma",
    "prisma-extension",
    "postgresql",
    "before-after-diff",
    "soc2",
    "compliance",
    "nestjs-module",
    "saas"
  ],
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/e2e/jest-e2e.config.ts --runInBand",
    "prisma:test:generate": "dotenv -e .env.test -- prisma generate",
    "prisma:test:push": "dotenv -e .env.test -- prisma db push",
    "docker:up": "docker compose -f test/e2e/docker-compose.yml up -d",
    "docker:down": "docker compose -f test/e2e/docker-compose.yml down",
    "bench": "npx ts-node benchmarks/audit-overhead.ts",
    "test:e2e:setup": "npm run docker:up -- --wait --wait-timeout 60 && npm run prisma:test:push && npm run prisma:test:generate",
    "test:e2e:full": "node scripts/run-e2e.cjs",
    "test:e2e:teardown": "npm run docker:down"
  },
  "peerDependencies": {
    "@nestarc/tenancy": ">=0.1.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestarc/tenancy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^8.0.0",
    "express": "^5.0.0",
    "jest": "^29.7.0",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
