generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  posts     Post[]
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model Post {
  id        String    @id @default(uuid())
  title     String
  authorId  String    @map("author_id")
  author    User      @relation(fields: [authorId], references: [id])
  deletedAt DateTime? @map("deleted_at")

  @@map("posts")
}
