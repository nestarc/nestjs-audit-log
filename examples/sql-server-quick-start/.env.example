# Use an existing disposable SQL Server 2025 database, not application production data.
# Braces delimit a SQL Server connection-string value containing punctuation.
# trustServerCertificate=true is for a local development server only.
DATABASE_URL=sqlserver://localhost:1433;database=audit_demo;user=audit_demo_user;password={replace-me};schema=dbo;encrypt=true;trustServerCertificate=true
